@model TiendaDeSnack.Models.Venta
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using TiendaDeSnack.Models
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Detalle Pedido";

    // Obtenemos el rol desde la sesión
    var rol = Context.Session.GetString("Rol");
    bool esAdmin = !string.IsNullOrEmpty(rol) && rol.Equals("Admin", StringComparison.OrdinalIgnoreCase);

    // Solo activamos modo edición si es Admin Y la acción es Editar
    bool isEditing = (ViewContext.RouteData.Values["action"] as string) == "EditarDetallePedido" && esAdmin;
}

<div class="container py-5">
    <h1 class="mb-4">Pedido #@Model.Id.ToString().Substring(0, 8)...</h1>

    @* --- MODO EDICIÓN (SOLO ADMIN) --- *@
    @if (isEditing)
    {
        <form asp-action="GuardarDetallePedido" method="post">
            @Html.AntiForgeryToken() <input type="hidden" asp-for="Id" />

            <div class="card p-4 border-warning mb-4">
                <h4 class="text-warning">Editando Información</h4>
                <div class="mb-2"><label>Nombre:</label> <input asp-for="ClienteNombre" class="form-control" /></div>
                <div class="mb-2"><label>Dirección:</label> <input asp-for="CalleNumero" class="form-control" /></div>
                <div class="row mb-2">
                    <div class="col"><input asp-for="Ciudad" class="form-control" placeholder="Ciudad" /></div>
                    <div class="col"><input asp-for="CodigoPostal" class="form-control" placeholder="CP" /></div>
                </div>
                <div class="mb-2">
                    <label>Estado:</label>
                    <select asp-for="Estado" class="form-select">
                        <option>Preparando</option>
                        <option>Enviado</option>
                        <option>Entregado</option>
                        <option>Cancelado</option>
                        <option>Completada</option>
                    </select>
                </div>
            </div>

            <h4 class="mt-4">Ítems (Inventario)</h4>
            <table class="table">
                <thead><tr><th>Prod</th><th>Cant</th><th>Subtotal</th><th>Acción</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@d.Producto?.Nombre</td>
                            <td>
                                @* Formulario pequeño para actualizar cantidad *@
                                <div class="input-group input-group-sm" style="width: 120px;">
                                    <input form="form-qty-@d.Id" type="number" name="nuevaCantidad" value="@d.Cantidad" min="1" class="form-control" />
                                    <button form="form-qty-@d.Id" class="btn btn-secondary">Ok</button>
                                </div>
                            </td>
                            <td>$@d.Subtotal.ToString("N2")</td>
                            <td>
                                <button form="form-del-@d.Id" class="btn btn-sm btn-danger">X</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-3">
                <button type="submit" class="btn btn-success fw-bold">Guardar Cambios Generales</button>
                <a asp-action="DetallePedido" asp-route-id="@Model.Id" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>

        @* Formularios auxiliares ocultos para evitar anidamiento *@
        @foreach (var d in Model.Detalles)
        {
            <form id="form-qty-@d.Id" asp-action="ActualizarDetalleItem" method="post" style="display:none;">
                @Html.AntiForgeryToken() <input type="hidden" name="detalleId" value="@d.Id" /><input type="hidden" name="ventaId" value="@Model.Id" />
            </form>
            <form id="form-del-@d.Id" asp-action="EliminarDetalleItem" method="post" onsubmit="return confirm('¿Eliminar?');" style="display:none;">
                @Html.AntiForgeryToken() <input type="hidden" name="detalleId" value="@d.Id" /><input type="hidden" name="ventaId" value="@Model.Id" />
            </form>
        }
    }
    else
    {
        @* --- MODO LECTURA (CLIENTE Y ADMIN) --- *@
        <p><strong>Fecha:</strong> @Model.Fecha.ToLocalTime()</p>
        <p><strong>Cliente:</strong> @Model.ClienteNombre</p>
        <p><strong>Dirección:</strong> @Model.CalleNumero, @Model.Ciudad</p>
        <p><strong>Estado:</strong> <span class="badge bg-warning text-dark">@Model.Estado</span></p>
        <p><strong>Total:</strong> $@Model.Total.ToString("N2")</p>

        <h4 class="mt-4">Ítems</h4>
        <table class="table table-striped">
            <thead><tr><th>Producto</th><th>Cant.</th><th>Precio</th><th>Subtotal</th></tr></thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@d.Producto?.Nombre</td>
                        <td>@d.Cantidad</td>
                        <td>$@d.PrecioUnitario.ToString("N2")</td>
                        <td>$@d.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-4">
            @if (esAdmin)
            {
                @* SOLO EL ADMIN VE ESTE BOTÓN *@
                <a asp-action="EditarDetallePedido" asp-route-id="@Model.Id" class="btn btn-warning">Editar Pedido</a>
                <a asp-action="Panel" asp-route-tab="Pedidos" class="btn btn-secondary">Volver al Panel</a>
            }
            else
            {
                @* EL CLIENTE SOLO VE ESTE *@
                <a asp-action="MisPedidos" class="btn btn-secondary">Volver a Mis Pedidos</a>
            }
        </div>
    }
</div>