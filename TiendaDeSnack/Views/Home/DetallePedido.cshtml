@model TiendaDeSnack.Models.Venta
@using System.Linq
@using TiendaDeSnack.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers

@* Las directivas de uso son esenciales para evitar errores de compilación *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Mvc.Rendering @* Referencia adicional para máxima compatibilidad *@

@{
    ViewData["Title"] = "Detalle Pedido";
    // Detecta si la acción actual es EditarDetallePedido para cambiar a modo formulario.
    bool isEditing = (ViewContext.RouteData.Values["action"] as string) == "EditarDetallePedido";
}

<div class="container py-5">
    <h1 class="mb-4">Pedido #@Model.Id.ToString().Substring(0, 8)...</h1>

    @* INICIO: BLOQUE DE EDICIÓN (Con formularios y campos de entrada) *@
    @if (isEditing)
    {
        <form asp-action="GuardarDetallePedido" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <p><strong>Fecha:</strong> @Model.Fecha.ToLocalTime()</p>

            <h4 class="mt-4">Datos del Cliente y Envío</h4>
            <p>
                <strong>Nombre:</strong>
                <input asp-for="ClienteNombre" class="form-control d-inline w-50" />
            </p>

            <p>
                <strong>Dirección:</strong>
                <input asp-for="CalleNumero" class="form-control d-inline w-75 mb-2" />
                <br />
                <label>Ciudad:</label> <input asp-for="Ciudad" class="form-control d-inline w-50" />
                <label class="ms-3">C.P.:</label> <input asp-for="CodigoPostal" class="form-control d-inline w-25" />
            </p>

            <h4 class="mt-4">Estado y Pago</h4>
            <p>
                <strong>Estado:</strong>
                <select asp-for="Estado" class="form-select d-inline w-auto">
                    <option>Preparando</option>
                    <option>Enviado</option>
                    <option>Entregado</option>
                    <option>Cancelado</option>
                    <option>Completada</option>
                </select>
            </p>
            <p><strong>Total:</strong> $@Model.Total.ToString("N2")</p>
            <p><strong>Método de Pago:</strong> @Model.MetodoPago</p>

            <h4 class="mt-4">Ítems del Pedido</h4>
            <table class="table">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Cant.</th>
                        <th>Precio Unit.</th>
                        <th>Subtotal</th>
                        <th>Acción</th> @* La columna de acción siempre está en este bloque *@
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>@d.Producto?.Nombre</td>

                            @* Formulario para actualizar cantidad (item por item) *@
                            <td>
                                <form asp-action="ActualizarDetalleItem" method="post" class="d-flex align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="detalleId" value="@d.Id" />
                                    <input type="hidden" name="ventaId" value="@Model.Id" />
                                    <input type="number" name="nuevaCantidad" value="@d.Cantidad" min="1" class="form-control form-control-sm w-50 me-2" required style="width: 70px;" />
                                    <button type="submit" class="btn btn-sm btn-secondary">OK</button>
                                </form>
                            </td>

                            <td>$@d.PrecioUnitario.ToString("N2")</td>
                            <td>$@d.Subtotal.ToString("N2")</td>

                            <td>
                                <form asp-action="EliminarDetalleItem" method="post" onsubmit="return confirm('¿Eliminar item del pedido y recalcular total?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="detalleId" value="@d.Id" />
                                    <input type="hidden" name="ventaId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="mt-4">
                <button type="submit" class="btn btn-success">Guardar Cambios</button> @* Botón para guardar metadata (nombre, dirección, etc.) *@
                <a asp-action="DetallePedido" asp-route-id="@Model.Id" class="btn btn-secondary">Cancelar Edición</a>
            </div>
        </form>
    }
    @* FIN: BLOQUE DE EDICIÓN *@

    @* INICIO: BLOQUE DE SOLO LECTURA (Si isEditing es false) *@
    else
    {
        <p><strong>Fecha:</strong> @Model.Fecha.ToLocalTime()</p>

        <h4 class="mt-4">Datos del Cliente y Envío</h4>
        <p>
            <strong>Nombre:</strong>
            @Model.ClienteNombre
        </p>

        <p>
            <strong>Dirección:</strong>
            @Model.CalleNumero, @Model.Ciudad, C.P. @Model.CodigoPostal
        </p>

        <h4 class="mt-4">Estado y Pago</h4>
        <p>
            <strong>Estado:</strong>
            @Model.Estado
        </p>
        <p><strong>Total:</strong> $@Model.Total.ToString("N2")</p>
        <p><strong>Método de Pago:</strong> @Model.MetodoPago</p>

        <h4 class="mt-4">Ítems del Pedido (Solo lectura)</h4>
        <table class="table">
            <thead>
                <tr><th>Producto</th><th>Cant.</th><th>Precio Unit.</th><th>Subtotal</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Detalles)
                {
                    <tr>
                        <td>@d.Producto?.Nombre</td>
                        <td>@d.Cantidad</td>
                        <td>$@d.PrecioUnitario.ToString("N2")</td>
                        <td>$@d.Subtotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="mt-4">
            <a asp-action="EditarDetallePedido" asp-route-id="@Model.Id" class="btn btn-warning">Editar Pedido</a>
            <a asp-action="Panel" asp-route-tab="Pedidos" class="btn btn-secondary">Volver al Panel</a>
        </div>
    }
</div>