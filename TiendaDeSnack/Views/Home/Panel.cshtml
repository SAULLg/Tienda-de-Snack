@model IEnumerable<TiendaDeSnack.Models.Venta>
@using Microsoft.AspNetCore.Http
@using TiendaDeSnack.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Panel de administración";
    var usuario = Context.Session.GetString("Usuario");
    var tab = (ViewBag.Tab as string ?? "Productos").ToLower();
    var pedidos = ViewBag.Pedidos as List<TiendaDeSnack.Models.Venta>;
    var empleados = ViewBag.Empleados as List<TiendaDeSnack.Models.Empleado>;
}

@* INICIO: SECCIÓN HERO CONDICIONAL (Visible solo si es la pestaña Productos) *@
@if (tab == "productos")
{
    <div class="home-page-content">
        <div class="hero-section">
            <div class="hero-text-container">
                <h1 class="snack-title">SNACK JR&SP</h1>
                <p style="color:#FFD700; font-weight:600; font-size:1.3em; margin-top:25px;">
                    Hola, @usuario
                </p>
            </div>
            <div class="snack-image-circle"></div>

            <div class="contact-info-panel">
                <p><i class="fab fa-facebook-f icon-facebook"></i> SNACK JR&SP</p>
                <p><i class="fab fa-whatsapp icon-whatsapp"></i> 686 316 0010</p>
            </div>
        </div>
    </div>
}

    @* ---------- Pedidos ---------- *@
    else if (tab == "pedidos")
    {
        <h2 class="text-center" style="color:#FFD700;">Pedidos</h2>
        <p class="text-center text-light mb-3">Historial y gestión de pedidos.</p>

        @if (pedidos == null || pedidos.Count == 0)
        {
            <div class="alert alert-info">No hay pedidos registrados todavía.</div>
        }
        else
        {
            <div class="table-responsive" style="background:#000; border:2px solid #FFD700; border-radius:12px;">
                <table class="table table-dark table-striped mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Total</th>
                            <th class="text-center" style="min-width: 500px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pedidos)
                        {
                            <tr>
                                <td>@p.Id.ToString().Substring(0, 8)...</td>
                                <td>@p.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@p.ClienteNombre</td>
                                <td>@p.Estado</td>
                                <td>$@p.Total.ToString("N2")</td>
                                <td>
                                    @* 1. BOTÓN VER DETALLE (Solo lectura) *@
                                    <a asp-action="DetallePedido" asp-route-id="@p.Id" class="btn btn-sm btn-info me-2">Ver</a>

                                    @* 2. BOTÓN EDITAR DATOS (Accede a la vista con campos de formulario) *@
                                    <a asp-action="EditarDetallePedido" asp-route-id="@p.Id" class="btn btn-sm btn-warning me-2">Editar</a>

                                    @* 3. Formulario para Actualizar Estado (Modificación Rápida) *@
                                    <form asp-action="ActualizarEstadoPedido" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <select name="estado" class="form-select form-select-sm d-inline w-auto">
                                            <option value="Preparando" selected="@(p.Estado == "Preparando" ? "selected" : null)">Preparando</option>
                                            <option value="Enviado" selected="@(p.Estado == "Enviado" ? "selected" : null)">Enviado</option>
                                            <option value="Entregado" selected="@(p.Estado == "Entregado" ? "selected" : null)">Entregado</option>
                                            <option value="Cancelado" selected="@(p.Estado == "Cancelado" ? "selected" : null)">Cancelado</option>
                                            <option value="Completada" selected="@(p.Estado == "Completada" ? "selected" : null)">Completada</option>
                                        </select>
                                        <button class="btn btn-sm btn-secondary ms-1">Actualizar</button>
                                    </form>

                                    @* 4. Formulario para ELIMINAR PEDIDO *@
                                    <form asp-action="EliminarPedido" method="post" class="d-inline ms-2"
                                          onsubmit="return confirm('¿Estás seguro de que quieres eliminar el pedido @p.Id.ToString().Substring(0, 8)...? Esto es permanente.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ---------- Empleados ---------- *@
    else if (tab == "empleados")
    {
        <h2 class="text-center" style="color:#FFD700;">Gestión de Empleados</h2>
        <p class="text-center text-light mb-3">Alta, baja y edición de personal (Admin, Repartidores, etc.).</p>

        <div style="display:flex; justify-content:center; margin-bottom:20px;">
            <a asp-controller="Home" asp-action="RegistroEmpleado" class="btn btn-warning fw-bold" style="color:#000; border-radius:28px; padding:10px 18px;">Registrar Nuevo Empleado</a>
        </div>

        @if (empleados == null || empleados.Count == 0)
        {
            <div class="alert alert-info">No hay empleados registrados.</div>
        }
        else
        {
            <div class="table-responsive" style="background:#000; border:2px solid #FFD700; border-radius:12px;">
                <table class="table table-dark table-striped mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Nombre Completo</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in empleados)
                        {
                            <tr>
                                <td>@emp.Id.ToString().Substring(0, 8)...</td>
                                <td>@emp.Nombre @emp.Apellido_P</td>
                                <td>@emp.Usuario</td>
                                <td>@emp.TipoUsuario</td>
                                <td class="text-center">
                                    @* Botón para editar (enlaza a la acción EditarEmpleado en el controlador Home) *@
                                    <a asp-action="EditarEmpleado" asp-route-id="@emp.Id" class="btn btn-sm btn-info me-2">Editar</a>

                                    @* Formulario para ELIMINAR EMPLEADO *@
                                    <form asp-action="EliminarEmpleado" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Estás seguro de que quieres eliminar a @emp.Nombre @emp.Apellido_P (@emp.Usuario)? Esto es permanente.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ---------- Repartidores ---------- *@
    else if (tab == "repartidores")
    {
        <h2 class="text-center" style="color:#FFD700;">Repartidores</h2>
        <p class="text-center text-light mb-3">Disponibilidad y estado de entregas.</p>
    }
</div>