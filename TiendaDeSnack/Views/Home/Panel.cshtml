@model IEnumerable<TiendaDeSnack.Models.Venta>
@using Microsoft.AspNetCore.Http
@using TiendaDeSnack.Models
@using Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Gestión";
    var usuario = Context.Session.GetString("Usuario");
    var tab = (ViewBag.Tab as string ?? "Productos").ToLower();
    var pedidos = ViewBag.Pedidos as List<TiendaDeSnack.Models.Venta>;
    var empleados = ViewBag.Empleados as List<TiendaDeSnack.Models.Empleado>;
}

@* Contenedor con margen superior para que no lo tape la barra de navegación *@
<div class="container" style="margin-top: 100px; margin-bottom: 50px;">


    @* Mensajes de Feedback *@
    @if (TempData["Ok"] != null)
    {
        <div class="alert alert-success text-center py-1 mb-3">@TempData["Ok"]</div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger text-center py-1 mb-3">@TempData["Err"]</div>
    }

    @* ---------- PRODUCTOS ---------- *@
    @if (tab == "productos")
    {
        <div style="padding-top: 20px; display:flex; justify-content:center;">
            <a asp-controller="AdminProductos" asp-action="Index" class="btn btn-warning fw-bold" style="color:#000; border-radius:28px; padding:10px 18px;">Gestionar Productos/Promociones</a>
        </div>
    }

    @* ---------- PEDIDOS ---------- *@
    else if (tab == "pedidos")
    {
        @if (pedidos == null || pedidos.Count == 0)
        {
            <div class="alert alert-info text-center">No hay pedidos registrados.</div>
        }
        else
        {
            <div class="table-responsive" style="border:1px solid #FFD700; border-radius:8px;">
                <table class="table table-dark table-striped mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Estado</th>
                            <th>Total</th>
                            <th class="text-center" style="min-width: 200px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in pedidos)
                        {
                            <tr>
                                <td>@p.Id.ToString().Substring(0, 8)...</td>
                                <td>@p.Fecha.ToLocalTime().ToString("dd/MM HH:mm")</td>
                                <td>@(p.ClienteNombre ?? "")</td>
                                <td>@p.Estado</td>
                                <td>$@p.Total.ToString("N2")</td>
                                <td class="text-center">
                                    <a asp-action="DetallePedido" asp-route-id="@p.Id" class="btn btn-sm btn-info me-1">Ver</a>

                                    <a asp-action="EditarDetallePedido" asp-route-id="@p.Id" class="btn btn-sm btn-warning me-1">Editar</a>

                                    <form asp-action="EliminarPedido" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar este pedido permanentemente?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">X</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ---------- EMPLEADOS ---------- *@
    else if (tab == "empleados")
    {
        <div style="margin-bottom:15px;">
            <a asp-controller="Home" asp-action="RegistroEmpleado" class="btn btn-warning fw-bold" style="color:#000; border-radius:28px;">+ Registrar Empleado</a>
        </div>

        @if (empleados == null || empleados.Count == 0)
        {
            <div class="alert alert-info text-center">No hay empleados registrados.</div>
        }
        else
        {
            <div class="table-responsive" style="border:1px solid #FFD700; border-radius:8px;">
                <table class="table table-dark table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Usuario</th>
                            <th>Rol</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in empleados)
                        {
                            <tr>
                                <td>@emp.Nombre @emp.Apellido_P</td>
                                <td>@emp.Usuario</td>
                                <td>@emp.TipoUsuario</td>
                                <td class="text-center">
                                    <a asp-action="EditarEmpleado" asp-route-id="@emp.Id" class="btn btn-sm btn-info me-2">Editar</a>

                                    <form asp-action="EliminarEmpleado" method="post" class="d-inline"
                                          onsubmit="return confirm('¿Eliminar empleado?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">X</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* ---------- REPARTIDORES ---------- *@
    else if (tab == "repartidores")
    {
        <div class="alert alert-info text-center">Módulo de repartidores (Pendiente)</div>
    }
</div>