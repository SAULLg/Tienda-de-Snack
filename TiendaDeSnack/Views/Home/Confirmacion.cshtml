@model TiendaDeSnack.Models.FinalizarCompraViewModel
@{
    ViewData["Title"] = "Pedido Confirmado";
}
<div class="container py-5">
    <h1 class="text-center">¡Gracias por tu compra!</h1>

    <div class="alert alert-success mt-4">
        <strong>Tu pedido se registró correctamente.</strong><br />
        Número de Pedido: <span class="fw-bold">@Model.OrderId</span>
    </div>

    <h3 class="mt-4">Resumen</h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Producto/Promo</th>
                <th>Cant.</th>
                <th>Precio Unit.</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.ItemsDelCarrito)
            {
                <tr>
                    <td>@(item.Producto?.Nombre ?? item.Promocion?.Nombre ?? "Item")</td>
                    <td>@item.Cantidad</td>
                    <td>$@item.PrecioUnitario.ToString("N2")</td>
                    <td>$@((item.PrecioUnitario * item.Cantidad).ToString("N2"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="3" class="text-end">Total:</td>
                <td>$@Model.TotalPagar.ToString("N2")</td>
            </tr>
        </tfoot>
    </table>

    <h4 class="mt-4">Datos de envío</h4>
    <p>
        Dirección: @Model.CalleNumero, @Model.Ciudad, CP: @Model.CodigoPostal<br />
        Método de pago: @Model.MetodoPago
    </p>

    <a asp-action="Menu" class="btn btn-warning">Seguir comprando</a>
</div>